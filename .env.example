# Core server
DATABASE_URL=postgres://postgres:postgres@localhost:5432/relaxation_hub
JWT_KEY=change-me
PORT=8080

# OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5173/oauth/google/callback
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CALLBACK_URL=http://localhost:5173/oauth/apple/callback
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# AWS S3 uploads (optional)
AWS_S3_BUCKET=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Push (Firebase) — choose env vars OR file path
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Inline credentials alternative:
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Relaxation Hub
BOOKING_EMAIL_TIMEZONE=Asia/Manila
BOOKING_DDAY_EMAIL_HOUR=7

# Geocoding / Routing providers
GEOCODER_PROVIDER=nominatim          # nominatim | mapbox
ROUTING_PROVIDER=osrm                # osrm | mapbox
NOMINATIM_BASE=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=relaxation-hub-server/1.0 (dev@relaxationhub.test)
OSRM_BASE=https://router.project-osrm.org
OSRM_PROFILE=driving                 # driving | cycling | foot
MAPBOX_API_TOKEN=                    # optional fallback
